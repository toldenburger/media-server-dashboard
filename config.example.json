{
  "title": "Media Server Dashboard",
  "port": 8900,
  "bind": ["127.0.0.1", "<your tailscale ip, from: tailscale ip -4>"],
  "location": { "lat": 52.37, "lon": 4.9 },
  "mediarium_url": "http://127.0.0.1:8264",
  "mediarium_open": "http://<an address your browser can reach>:8264",
  "mediarium_container": "mediarium",
  "mediarium_key_file": "mediarium_api_key",
  "secrets_dir": "secrets",
  "launch": { "my_music_app": { "match": "part of the app's window class or title", "command": "command that starts it" } },
  "sources": {
    "birdnet": { "url": "http://birdnet-go.local:8080" },
    "pihole": { "url": "http://pi.hole" },
    "navidrome": { "db": "/path/to/navidrome/data/navidrome.db", "music_root": "/path/to/your/music", "launch": "my_music_app" },
    "cloudflared": { "url": "http://127.0.0.1:20241" },
    "sunshine": { "folder": "~/.config/sunshine", "open": "https://<an address your browser can reach>:47990" },
    "agents": { "slots": 3, "opencode_api": true },
    "backups": { "jobs": [["Label shown on the vault", "name-of-a-systemd-user-unit-without-.service"]] },
    "jellyfin": { "url": "http://127.0.0.1:8096", "open": "http://<an address your browser can reach>:8096" },
    "immich": { "url": "http://127.0.0.1:2283" },
    "seerr": { "url": "http://127.0.0.1:5055" },
    "homeassistant": {
      "url": "http://127.0.0.1:8123",
      "climate": "climate.living_room",
      "water_heater": "water_heater.boiler",
      "price": "sensor.electricity_price",
      "price_forecast": "sensor.electricity_price_forecast",
      "light_prefix": "light.living_room",
      "compressor": "sensor.heat_pump_compressor_frequency",
      "heat_power": "sensor.heat_pump_heat_output_kw",
      "devices": { "coffee": { "name": "Coffee machine", "kind": "coffee", "power": "sensor.kitchen_plug_power", "energy": "sensor.kitchen_plug_energy", "active_w": 100 } },
      "solar": { "power": "sensor.solar_current_power", "lifetime": "sensor.solar_lifetime_energy", "today": "sensor.solar_energy_today" },
      "heatpump": {
        "electric_power": "sensor.heat_pump_electric_power", "cop": "sensor.heat_pump_cop_now", "cop_today": "sensor.heat_pump_cop_today",
        "heat_today": "sensor.heat_pump_heat_today", "electric_today": "sensor.heat_pump_electric_today",
        "outdoor": "sensor.outdoor_temperature", "leaving_water": "sensor.leaving_water_temperature",
        "defrost": "binary_sensor.heat_pump_defrost", "hot_water": "binary_sensor.heat_pump_valve_hot_water", "fan": "sensor.heat_pump_fan_rpm", "error": "sensor.heat_pump_error"
      }
    },
    "nextcloud": { "container": "nextcloud", "user": "your-nextcloud-user" },
    "freshrss": { "container": "freshrss", "user": "your-freshrss-user" },
    "bookorbit": { "container": "bookorbit-db" },
    "spaarpot": { "db": "/path/to/spaarpot.db" },
    "headphones": { "db": "/path/to/headphones/config/headphones.db", "open": "http://<an address your browser can reach>:8181" },
    "linkwarden": { "container": "linkwarden-db", "user": "linkwarden", "database": "linkwarden", "open": "http://<an address your browser can reach>:3010" },
    "printer": { "queue": "your_cups_queue", "host": "<the printer's address on your network>", "open": "http://localhost:631/printers/your_cups_queue" },
    "opodsync": { "db": "/path/to/opodsync/data/data.sqlite", "open": "http://<an address your browser can reach>:8765" }
  },
  "sources_off": []
}
